{
  "name": "@repo/sanity-config",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pkg-utils build --strict --clean --check",
    "typecheck": "tsc",
    "lint": "eslint --cache --config eslint.config.mjs .",
    "watch": "pkg-utils watch --strict",
    "extract": "sanity schema extract --force",
    "extract:watch": "turbo watch --filter=\"@repo/sanity-config\" extract"
  },
  "dependencies": {
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/color-input": "^6.1.9",
    "@sanity/icons": "^5.3.0",
    "@sanity/ui": "^3.5.5",
    "@sanity/vision": "^6.22.0",
    "lodash.get": "^4.4.2",
    "pluralize-esm": "^9.0.5",
    "sanity-plugin-hotspot-array": "^5.0.23",
    "sanity-plugin-media": "^6.6.2"
  },
  "devDependencies": {
    "@portabletext/types": "^4.0.2",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@sanity/pkg-utils": "^10.9.2",
    "@types/lodash.get": "^4.4.9",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^6",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
