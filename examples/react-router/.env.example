# Required
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Signs the preview cookie. Use a long random string.
SANITY_PREVIEW_SECRET=

# Optional: preview and Presentation. A token with the Viewer role.
SANITY_VIEWER_TOKEN=
SANITY_STUDIO_URL=http://localhost:3333

# Optional: shared secret for the Sync Tag Invalidate Function.
SANITY_LIVE_SECRET=
