{
  "name": "storefront",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.4",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "deploy": "shopify hydrogen deploy --no-lockfile-check",
    "typecheck": "npm run codegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && sanity typegen generate && react-router typegen"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@sanity/client": "^7.14.0",
    "@shopify/hydrogen": "2026.4.4",
