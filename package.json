{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo --ui tui dev",
    "watch:apps": "turbo --ui tui dev --filter=\"./examples/**\"",
    "watch:package": "turbo --ui tui dev --filter=\"hydrogen-sanity\"",
    "watch:sanity-config": "turbo --ui tui dev --filter=\"@repo/sanity-config\"",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "vitest",
    "format": "prettier --cache --write --ignore-unknown .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "turbo": "^2.10.7",
    "vitest": "^4.1.10",
    "vitest-github-actions-reporter": "^0.11.1"
  },
  "packageManager": "pnpm@11.9.0"
}
